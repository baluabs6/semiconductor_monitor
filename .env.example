# Copy to .env (never commit .env). Values are masked here on purpose.
ANTHROPIC_API_KEY=****
SERVICE_API_KEY=****
ANTHROPIC_MODEL=claude-sonnet-5-5
SCENARIO_INTERVAL_SECONDS=60
# Directory of your own runbooks (*.md). Blank = bundled SAMPLE runbooks.
RUNBOOKS_DIR=
# Air-gapped / private deployments:
AI_DISABLED=
SPRING_PROFILES_ACTIVE=
BEDROCK_MODEL_ID=
OLLAMA_MODEL=llama3.1
MAVEN_PROFILE=
