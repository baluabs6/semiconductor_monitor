# C + C++ + Python backend (FastAPI by default). Build from the project root:
#   docker build -f Dockerfile.backend -t semiconductor-backend .
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY build.sh ./build.sh
COPY c_src ./c_src
COPY cpp_src ./cpp_src
RUN chmod +x build.sh && ./build.sh
COPY backend ./backend
RUN pip install --no-cache-dir -r backend/requirements.txt
RUN useradd -m app && mkdir -p /data && chown app /data
USER app
WORKDIR /app/backend
ENV ALERTS_DB_PATH=/data/alerts.db
EXPOSE 8001
CMD ["uvicorn", "fastapi_app:app", "--host", "0.0.0.0", "--port", "8001"]
